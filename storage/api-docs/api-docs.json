{
    "openapi": "3.0.0",
    "info": {
        "title": "TelU Cup Backend API Documentation",
        "description": "Detailed and professional API documentation for the TelU Cup backend project.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Primary API Server"
        }
    ],
    "paths": {
        "/chatbot/ask": {
            "post": {
                "tags": [
                    "Chatbot"
                ],
                "summary": "Chatbot Helpdesk",
                "description": "Endpoint untuk tanya jawab otomatis terkait Tel-U Cup.",
                "operationId": "chatbotAsk",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "question"
                                ],
                                "properties": {
                                    "question": {
                                        "type": "string",
                                        "example": "bagaimana aturan pertandingan?"
                                    },
                                    "user_risk": {
                                        "type": "string",
                                        "example": "low"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Berhasil mendapatkan jawaban",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "assistant_name": {
                                            "type": "string"
                                        },
                                        "support_type": {
                                            "type": "string"
                                        },
                                        "answer": {
                                            "type": "string"
                                        },
                                        "options": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Chatbot",
            "description": "Chatbot"
        }
    ]
}